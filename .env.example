# SLORA — environment variables template.
# Copy to `.env.local` and fill in. NEVER commit real values.
# Anything NOT prefixed NEXT_PUBLIC_ is server-only and never reaches the browser.

# ── Public ─────────────────────────────────────────────────────────────────────
# Official SLORA WhatsApp number: digits only, with country code, no "+" or spaces.
# Also used as SLORA's general contact/call number (the "CONTACT US" button and the Contact
# section's WhatsApp/Call buttons; see lib/contact.ts) — SLORA confirmed it is the same number.
# MUST be supplied by SLORA. Leave empty until then (the site shows contact options instead).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Lead notifications (server-only) ───────────────────────────────────────────
# Telegram bot that posts each new enquiry to the SLORA team chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: one or more recipient addresses (comma-separated), supplied by SLORA.
LEAD_NOTIFICATION_EMAIL=
EMAIL_PROVIDER_API_KEY=
# Verified "from" address at your email provider (providers refuse unverified senders).
# Not in the master prompt's list, but required in practice.
EMAIL_FROM=

# ── AI chatbot (server-only, used from Phase 3) ────────────────────────────────
AI_API_KEY=

# ── Lead storage ───────────────────────────────────────────────────────────────
# Development: leads are written to ./.data/leads.json (git-ignored).
# Tests use LEAD_STORE=memory. PRODUCTION needs a real database — decision pending
# (see IMPLEMENTATION_PLAN.md §8, item 12). Until then a production build refuses
# to accept leads rather than silently losing them.
# LEAD_STORE=memory | file
DATABASE_URL=
